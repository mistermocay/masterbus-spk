# Salin file ini menjadi .env, lalu isi lokasi service-account Firebase yang disimpan di luar Git.
FIREBASE_PROJECT_ID=masterbus-spk
FIREBASE_STORAGE_BUCKET=masterbus-spk.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./secrets/masterbus-spk-service-account.json

# Default hanya bisa dibuka dari komputer yang menjalankan server.
HOST=127.0.0.1
PORT=3000

# Untuk server di jaringan kantor/VPN: set HOST=0.0.0.0 dan cantumkan IP klien tepercaya.
# Jangan mengosongkan allowlist saat server dapat diakses dari jaringan lain.
ALLOWED_CLIENT_IPS=
